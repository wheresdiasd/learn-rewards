# Algorand TestNet Configuration
ALGOD_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=

# Your organization's TestNet wallet private key (base64 encoded)
# WARNING: For demo/testnet use only! Never use mainnet private keys here!
#
# To convert your mnemonic phrase to a private key:
# Run: node convert-mnemonic.js
# Supports both 24-word (Pera Wallet) and 25-word (Algorand) mnemonics
ORG_PRIVATE_KEY=your_base64_encoded_private_key_here

# The ASA (Algorand Standard Asset) ID to distribute as rewards
# Create an ASA on TestNet using: node create-asa.js
ASA_ID=123456789
