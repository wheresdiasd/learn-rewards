# Algorand TestNet Configuration
ALGOD_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=

# Your 24-word BIP-39 mnemonic (from Pera Wallet)
# This is the SAME mnemonic that created your ASA and holds the tokens
# Copy this from your Pera Wallet backup
MNEMONIC=your 24 word bip39 mnemonic phrase goes here from pera wallet

# Optional BIP-39 passphrase (aka "25th word")
# Leave empty if you didn't set one when creating your wallet
BIP39_PASS=

# HD Derivation Path (usually account=0, index=0 for first address)
ACCOUNT=0
INDEX=0

# The ASA ID (your existing LearnToken ASA)
# You already created this - just put the ID here
ASA_ID=

# Smart Contract Application ID (filled automatically after deployment)
SMART_CONTRACT_APP_ID=
